<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_presets_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#15171C">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ARKA PRESETS"
        android:textColor="#FFE9C7"
        android:textStyle="bold"
        android:textSize="13sp"
        android:paddingBottom="8dp" />
    <TextView
        android:id="@+id/widget_preset_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No presets saved yet"
        android:textColor="#FFE9C7"
        android:textSize="13sp"
        android:visibility="gone" />
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:rowCount="4"
        android:useDefaultMargins="true">
        <TextView
            android:id="@+id/widget_preset_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:background="#24262D"
            android:textColor="#FFE9C7"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/widget_preset_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:background="#24262D"
            android:textColor="#FFE9C7"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/widget_preset_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:background="#24262D"
            android:textColor="#FFE9C7"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/widget_preset_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:background="#24262D"
            android:textColor="#FFE9C7"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/widget_preset_5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:background="#24262D"
            android:textColor="#FFE9C7"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/widget_preset_6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:background="#24262D"
            android:textColor="#FFE9C7"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/widget_preset_7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:background="#24262D"
            android:textColor="#FFE9C7"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/widget_preset_8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:background="#24262D"
            android:textColor="#FFE9C7"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />
    </GridLayout>
</LinearLayout>
